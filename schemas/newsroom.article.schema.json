{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sovereign.local/schemas/newsroom.article.schema.json",
  "title": "Newsroom Article Payload",
  "type": "object",
  "required": [
    "headline",
    "slug",
    "body",
    "fact_checks"
  ],
  "properties": {
    "headline": {
      "type": "string",
      "minLength": 1
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "body": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "fact_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "claim",
          "source"
        ],
        "properties": {
          "claim": {
            "type": "string"
          },
          "source": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "genealogy_of_thought": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
