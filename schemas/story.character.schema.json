{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sovereign.local/schemas/story.character.schema.json",
  "title": "Story Character Payload",
  "type": "object",
  "required": [
    "name",
    "role",
    "hagen_questions"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "role": {
      "type": "string"
    },
    "goal": {
      "type": "string"
    },
    "conflict": {
      "type": "string"
    },
    "hagen_questions": {
      "type": "array",
      "minItems": 9,
      "items": {
        "type": "string"
      }
    },
    "world_notes": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
